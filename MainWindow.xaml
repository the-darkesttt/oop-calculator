<Window x:Class="CalculatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator"
        Width="730"
        Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#B68CE8"
        FontFamily="Consolas">

        <Window.Resources>

                <Style x:Key="CalcButton"
                       TargetType="Button">
                        <Setter Property="Background"
                                Value="#F5F5F5"/>
                        <Setter Property="Foreground"
                                Value="#303030"/>
                        <Setter Property="BorderBrush"
                                Value="#303030"/>
                        <Setter Property="BorderThickness"
                                Value="1.5"/>
                        <Setter Property="FontSize"
                                Value="21"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="Margin"
                                Value="4"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>

                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10">

                                                        <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Opacity"
                                                                        Value="0.8"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Opacity"
                                                                        Value="0.6"/>
                                                        </Trigger>

                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Opacity"
                                                                        Value="0.35"/>
                                                        </Trigger>

                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="OperationButton"
                       TargetType="Button"
                       BasedOn="{StaticResource CalcButton}">

                        <Setter Property="Background"
                                Value="#303030"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                </Style>

                <Style x:Key="AccentButton"
                       TargetType="Button"
                       BasedOn="{StaticResource CalcButton}">

                        <Setter Property="Background"
                                Value="#D1FA45"/>
                </Style>

                <Style x:Key="HexButton"
                       TargetType="Button"
                       BasedOn="{StaticResource CalcButton}">

                        <Setter Property="FontSize"
                                Value="16"/>
                        <Setter Property="Background"
                                Value="#EAEAEA"/>
                </Style>

                <Style x:Key="ModeButton"
                       TargetType="Button"
                       BasedOn="{StaticResource CalcButton}">

                        <Setter Property="Background"
                                Value="#303030"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="Width"
                                Value="80"/>
                        <Setter Property="Height"
                                Value="36"/>
                        <Setter Property="Margin"
                                Value="0,0,8,0"/>
                </Style>

                <Style x:Key="ActiveModeButton"
                       TargetType="Button"
                       BasedOn="{StaticResource ModeButton}">

                        <Setter Property="Background"
                                Value="#D1FA45"/>
                        <Setter Property="Foreground"
                                Value="#303030"/>
                </Style>

        </Window.Resources>

        <Grid>

                <Grid Width="510"
                      Height="620"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                        <Border Background="#303030"
                                CornerRadius="14"
                                Margin="13,13,0,0"/>

                        <Border Background="White"
                                BorderBrush="#303030"
                                BorderThickness="2"
                                CornerRadius="14"
                                Margin="0,0,13,13">

                                <Grid Margin="25">

                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="55"/>
                                                <RowDefinition Height="48"/>
                                                <RowDefinition Height="113"/>
                                                <RowDefinition Height="48"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">

                                                <TextBlock Text="Calculator"
                                                           FontSize="29"
                                                           FontWeight="Bold"
                                                           Foreground="#303030"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Text="RGR / 09"
                                                           FontSize="12"
                                                           Foreground="#777777"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel Grid.Row="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                                <TextBlock Text="MODE"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#303030"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,15,0"/>

                                                <Button x:Name="DecButton"
                                                        Content="DEC"
                                                        Style="{StaticResource ActiveModeButton}"/>

                                                <Button x:Name="BinButton"
                                                        Content="BIN"
                                                        Style="{StaticResource ModeButton}"/>

                                                <Button x:Name="HexButton"
                                                        Content="HEX"
                                                        Style="{StaticResource ModeButton}"/>

                                        </StackPanel>

                                        <Border Grid.Row="2"
                                                Background="#F8F8F8"
                                                BorderBrush="#D0D0D0"
                                                BorderThickness="1.5"
                                                CornerRadius="10"
                                                Margin="4,4,4,12"
                                                Padding="16,10">

                                                <StackPanel VerticalAlignment="Center">

                                                        <TextBlock x:Name="ExpressionText"
                                                                   Text=" "
                                                                   FontSize="14"
                                                                   Foreground="#777777"
                                                                   HorizontalAlignment="Right"
                                                                   Height="22"/>

                                                        <TextBlock x:Name="DisplayText"
                                                                   Text="0"
                                                                   FontSize="38"
                                                                   FontWeight="Bold"
                                                                   Foreground="#303030"
                                                                   HorizontalAlignment="Right"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                </StackPanel>

                                        </Border>

                                        <UniformGrid Grid.Row="3"
                                                     Rows="1"
                                                     Columns="6"
                                                     Margin="0,0,0,5">

                                                <Button Content="A"
                                                        Style="{StaticResource HexButton}"
                                                        IsEnabled="False"/>

                                                <Button Content="B"
                                                        Style="{StaticResource HexButton}"
                                                        IsEnabled="False"/>

                                                <Button Content="C"
                                                        Style="{StaticResource HexButton}"
                                                        IsEnabled="False"/>

                                                <Button Content="D"
                                                        Style="{StaticResource HexButton}"
                                                        IsEnabled="False"/>

                                                <Button Content="E"
                                                        Style="{StaticResource HexButton}"
                                                        IsEnabled="False"/>

                                                <Button Content="F"
                                                        Style="{StaticResource HexButton}"
                                                        IsEnabled="False"/>

                                        </UniformGrid>

                                        <UniformGrid Grid.Row="4"
                                                     Rows="5"
                                                     Columns="4">

                                                <Button Content="C"
                                                        Style="{StaticResource OperationButton}"
                                                        Click="Clear_Click"/>

                                                <Button Content="⌫"
                                                        Style="{StaticResource OperationButton}"
                                                        Click="Backspace_Click"/>

                                                <Button Content="1/x"
                                                        Style="{StaticResource OperationButton}"/>

                                                <Button Content="÷"
                                                        Style="{StaticResource OperationButton}"
                                                        Click="Operation_Click"/>

                                                <Button Content="7"
                                                        Style="{StaticResource CalcButton}"
                                                        Click="Digit_Click"/>

                                                <Button Content="8"
                                                        Style="{StaticResource CalcButton}"
                                                        Click="Digit_Click"/>

                                                <Button Content="9"
                                                        Style="{StaticResource CalcButton}"
                                                        Click="Digit_Click"/>

                                                <Button Content="×"
                                                        Style="{StaticResource OperationButton}"
                                                        Click="Operation_Click"/>

                                                <Button Content="4"
                                                        Style="{StaticResource CalcButton}"
                                                        Click="Digit_Click"/>

                                                <Button Content="5"
                                                        Style="{StaticResource CalcButton}"
                                                        Click="Digit_Click"/>

                                                <Button Content="6"
                                                        Style="{StaticResource CalcButton}"
                                                        Click="Digit_Click"/>

                                                <Button Content="−"
                                                        Style="{StaticResource OperationButton}"
                                                        Click="Operation_Click"/>

                                                <Button Content="1"
                                                        Style="{StaticResource CalcButton}"
                                                        Click="Digit_Click"/>

                                                <Button Content="2"
                                                        Style="{StaticResource CalcButton}"
                                                        Click="Digit_Click"/>

                                                <Button Content="3"
                                                        Style="{StaticResource CalcButton}"
                                                        Click="Digit_Click"/>

                                                <Button Content="+"
                                                        Style="{StaticResource OperationButton}"
                                                        Click="Operation_Click"/>

                                                <Button Content="±"
                                                        Style="{StaticResource OperationButton}"
                                                        Click="Operation_Click"/>

                                                <Button Content="0"
                                                        Style="{StaticResource CalcButton}"
                                                        Click="Digit_Click"/>

                                                <Button Content="."
                                                        Style="{StaticResource CalcButton}"
                                                        Click="Digit_Click"/>

                                                <Button Content="="
                                                        Style="{StaticResource AccentButton}"
                                                        Click="Equals_Click"/>

                                        </UniformGrid>

                                </Grid>

                        </Border>

                </Grid>

        </Grid>
</Window>